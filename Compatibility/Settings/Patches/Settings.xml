<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="XmlExtensions.UseSetting">
    <modId>keullaeseu.MaleWolfeinExpanded</modId>
    <key>MaleWolfeinProbSlider</key>
    <defaultValue>0.1</defaultValue>
    <apply>
      <Operation Class="PatchOperationReplace">
        <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="Wolfein_Race"]/alienRace/generalSettings/maleGenderProbability</xpath>
        <value>
          <maleGenderProbability>{MaleWolfeinProbSlider}</maleGenderProbability>
        </value>
      </Operation>
    </apply>
  </Operation>

  <Operation Class="PatchOperationRemove">
    <xpath>Defs/PawnKindDef[@Name="Wolfein_PawnBase"]/fixedGender</xpath>
  </Operation>
</Patch>
